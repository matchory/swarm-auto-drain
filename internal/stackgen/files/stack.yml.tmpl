version: "3.9"

# Generated by `swarm-auto-drain stack`. Pipe straight to docker:
#
#   swarm-auto-drain stack | docker stack deploy -c - {{.ServiceName}}
#
# Re-run after upgrading the binary to refresh the image tag.

services:
  {{.ServiceName}}:
    image: {{.ImageRegistry}}/swarm-auto-drain:{{.Version}}
    deploy:
      mode: global
      restart_policy:
        condition: any
        delay: 10s
      update_config:
        parallelism: 1
        delay: 30s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 30s
        failure_action: pause
        order: start-first
      resources:
        limits:
          cpus: "0.5"
          memory: 64M
    environment:
      NODE_HOSTNAME: "{{`{{.Node.Hostname}}`}}"
      LOCK_TTL_SECONDS: "1800"
      DRAIN_TIMEOUT_SECONDS: "300"
      ROLE_RECHECK_SECONDS: "30"
      LOG_LEVEL: "info"
      UNIX_SOCKET_GID: "{{.GID}}"
{{- if .AllowUnencrypted }}
      ALLOW_UNENCRYPTED_OVERLAY: "true"
{{- end }}
    networks:
      - {{.ServiceName}}-net
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
      - type: bind
        source: /var/run/swarm-auto-drain
        target: /var/run/swarm-auto-drain

networks:
  {{.ServiceName}}-net:
    driver: overlay
    internal: true
{{- if not .AllowUnencrypted }}
    driver_opts:
      encrypted: "true"
{{- end }}
