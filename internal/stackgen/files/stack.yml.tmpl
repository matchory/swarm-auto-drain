version: "3.9"

# Generated by `swarm-auto-drain stack`. Pipe straight to docker:
#
#   swarm-auto-drain stack | docker stack deploy -c - {{.ServiceName}}
#
# Re-run after upgrading the binary to refresh the image tag.

services:
  {{.ServiceName}}:
    image: {{.ImageRegistry}}/swarm-auto-drain:{{.Version}}
    # Draining a node stops this replica too (Swarm stops global tasks on
    # a drained node) while it may still be answering that node's /drain.
    # Keep it alive for DRAIN_TIMEOUT_SECONDS + 30s, the in-process
    # shutdown grace, so the answer reaches the host; Docker's 10s default
    # can kill it mid-request.
    stop_grace_period: 330s
    deploy:
      mode: global
      restart_policy:
        condition: any
        delay: 10s
      update_config:
        parallelism: 1
        delay: 30s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 30s
        failure_action: pause
        order: start-first
      resources:
        limits:
          cpus: "0.5"
          memory: 64M
        # Reservations make the swarm scheduler account for the
        # coordinator's footprint even on contended hosts — without
        # them a mass-restart storm can squeeze the coordinator at
        # exactly the moment its API needs to answer.
        reservations:
          cpus: "0.05"
          memory: 16M
    environment:
      NODE_HOSTNAME: "{{`{{.Node.Hostname}}`}}"
      LOCK_TTL_SECONDS: "1800"
      DRAIN_TIMEOUT_SECONDS: "300"
      ROLE_RECHECK_SECONDS: "30"
      LOG_LEVEL: "info"
      UNIX_SOCKET_GID: "{{.GID}}"
      # Metrics (Beta — defaults off; uncomment to enable):
      # METRICS_LISTEN_ADDR: ":9100"                 # Prometheus pull endpoint
      # OTEL_EXPORTER_OTLP_ENDPOINT: "collector:4318" # OTLP HTTP push target (host:port, no scheme)
      # METRICS_PUSH_INTERVAL_SECONDS: "15"
{{- if .AllowUnencrypted }}
      ALLOW_UNENCRYPTED_OVERLAY: "true"
{{- end }}
    # Only needed if METRICS_LISTEN_ADDR is enabled above: publish the
    # Prometheus listener host-side so a scraper can reach it per node
    # (node_exporter convention — one target per host).
    # ports:
    #   - target: 9100
    #     published: 9100
    #     protocol: tcp
    #     mode: host
    networks:
      - {{.ServiceName}}-net
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
      - type: bind
        source: /var/run/swarm-auto-drain
        target: /var/run/swarm-auto-drain

networks:
  {{.ServiceName}}-net:
    driver: overlay
    # internal: not routable from the swarm ingress mesh.
    internal: true
    # attachable: false blocks `docker network connect` from attaching
    # arbitrary containers to the coordinator overlay — defense-in-depth
    # layered on top of the IP-derived identity check.
    attachable: false
{{- if not .AllowUnencrypted }}
    driver_opts:
      encrypted: "true"
{{- end }}
